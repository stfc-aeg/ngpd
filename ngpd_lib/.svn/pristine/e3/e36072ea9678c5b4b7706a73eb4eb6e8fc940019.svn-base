from cffi import FFI
#platform="x86_64"
platform="w64"
if platform=="x86_64" :
    libdirs = ['../../../libs/libs.linux.x86_64/lib/']
    libs = ['ngpd_noadq14','img_mod', 'rt']
elif platform=="mgw64" :
    libdirs = ['../../../libs/libs.mgw64/lib/']
    libs = ['ngpd_noadq14','img_mod', 'ws2_32' ]
elif platform=="w64" :
    libdirs = ['../../../libs/libs.w64/lib/']
    libs = ['ngpd_noadq14','img_mod', 'pthreadVC2',  'ws2_32' ]
else:
    libdirs = ['../../../libs/libs.w64/lib/']
    libs = ['libngpd_noadq14.a','libimg_mod.a','ws2_32' ]
ffibuilder = FFI()
ffibuilder.set_source("pyngpd_cffi",
    r""" // passed to the real C compiler,
    #include "ngpd.h"
    """,
    libraries=libs,   # or a list of libraries to link with
    # (more arguments like setup.py's Extension class:
    include_dirs=['../include', '../../../libs/include'], library_dirs=libdirs, extra_compile_args=["-D__LINUX__"])

ffibuilder.cdef("""
typedef enum 
{
	NGPDDummy_None=0,
	NGPDDummy_FPGA=1,
	NGPDDummy_ADC=2,
	NGPDDummy_Preamp=4,
	NGPDDummy_All=0xFF
} NGPDDummy;

int ngpd_config_ngzmp(int ncards,  char* baseIPaddress, int basePort, char* baseMACaddress, int num_chan, int debug, int card_index, int do_init,  int dummy_system);
int ngpd_i2c_write_preamp_offset(int path, int chan, int num, u_int16_t *data);
int ngpd_i2c_read_preamp_offset(int path, int chan, int num, u_int16_t *data);

""")

if __name__ == "__main__":
    ffibuilder.compile(verbose=True)
